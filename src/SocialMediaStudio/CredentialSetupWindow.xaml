<Window x:Class="SocialMediaStudio.CredentialSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Account Setup" Width="520" Height="350"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#F3F6FA">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeadingText" FontSize="25" FontWeight="SemiBold" Foreground="#17324D"/>
        <TextBlock Grid.Row="1" Margin="0,8,0,20" TextWrapping="Wrap" Foreground="#52677A"
                   Text="Enter the developer credentials for this network. They are encrypted for your Windows account and are not stored in the app source code."/>
        <TextBlock Grid.Row="2" Text="App / Client ID" FontWeight="SemiBold"/>
        <TextBox x:Name="ClientIdBox" Grid.Row="3" Height="34" Margin="0,7,0,14" Padding="8,5"/>
        <StackPanel Grid.Row="4">
            <TextBlock Text="App / Client Secret (only when required)" FontWeight="SemiBold"/>
            <PasswordBox x:Name="ClientSecretBox" Height="34" Margin="0,7,0,0" Padding="8,5"/>
        </StackPanel>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancel" Width="95" Height="36" Margin="0,0,10,0" IsCancel="True"/>
            <Button Content="Save &amp; Continue" Width="140" Height="36" IsDefault="True" Click="SaveClick"/>
        </StackPanel>
    </Grid>
</Window>