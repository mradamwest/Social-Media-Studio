<Window x:Class="SocialMediaStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Social Media Studio" Width="1180" Height="760" MinWidth="980" MinHeight="650" WindowStartupLocation="CenterScreen">
<Grid Background="#F3F6FA"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#17324D"><StackPanel Margin="18"><TextBlock Text="SOCIAL MEDIA STUDIO" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,10,0,30"/><Button Content="Create Post" Height="44" Margin="0,0,0,10" Click="ShowCreatePost"/><Button Content="Planner" Height="44" Margin="0,0,0,10"/><Button Content="Media Library" Height="44" Margin="0,0,0,10"/><Button Content="Connected Accounts" Height="44" Click="ShowAccounts"/></StackPanel></Border>
<Grid Grid.Column="1" Margin="28">
<Grid x:Name="CreatePostView"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Create Post" FontSize="30" FontWeight="SemiBold" Foreground="#17324D"/>
<Grid Grid.Row="1" Margin="0,24,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="Media" FontSize="17" FontWeight="Bold"/><Border Height="180" Margin="0,8,18,20" BorderBrush="#9AA9B8" BorderThickness="2" CornerRadius="8" Background="White"><TextBlock Text="Drag &amp; drop video or images here&#10;or click Browse" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Foreground="#52677A"/></Border><TextBlock Text="Caption" FontSize="17" FontWeight="Bold"/><TextBox Height="150" Margin="0,8,18,0" AcceptsReturn="True" TextWrapping="Wrap"/></StackPanel>
<StackPanel Grid.Column="1"><TextBlock Text="Publish To" FontSize="17" FontWeight="Bold"/><WrapPanel Margin="0,8,0,20"><CheckBox Content="Facebook" Margin="0,6,18,6"/><CheckBox Content="Instagram" Margin="0,6,18,6"/><CheckBox Content="Threads" Margin="0,6,18,6"/><CheckBox Content="TikTok" Margin="0,6,18,6"/><CheckBox Content="YouTube" Margin="0,6,18,6"/><CheckBox Content="X" Margin="0,6,18,6"/><CheckBox Content="LinkedIn" Margin="0,6,18,6"/><CheckBox Content="Pinterest" Margin="0,6,18,6"/><CheckBox Content="Bluesky" Margin="0,6,18,6"/></WrapPanel><TextBlock Text="Status" FontSize="17" FontWeight="Bold"/><TextBlock Text="Draft — ready to prepare" Margin="0,8,0,0" Foreground="#52677A"/></StackPanel></Grid>
<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Save Draft" Width="120" Height="42" Margin="0,0,10,0"/><Button Content="Schedule" Width="120" Height="42" Margin="0,0,10,0"/><Button Content="Post Now" Width="120" Height="42"/></StackPanel></Grid>
<Grid x:Name="AccountsView" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Connected Accounts" FontSize="30" FontWeight="SemiBold" Foreground="#17324D"/><TextBlock Grid.Row="1" Text="Connect, reconnect, or disconnect your publishing channels." Foreground="#52677A" Margin="0,8,0,20"/><ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="AccountsList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="#D6DEE7" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Provider}" FontSize="17" FontWeight="Bold" Foreground="#17324D"/><TextBlock Text="{Binding State}" Foreground="#52677A" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Connect / Reconnect" Width="130" Height="36" Margin="0,0,8,0" Tag="{Binding Provider}" Click="ConnectAccount"/><Button Content="Disconnect" Width="95" Height="36" Tag="{Binding Provider}" Click="DisconnectAccount"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid>
</Grid></Grid></Window>