<Window x:Class="SocialMediaStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Social Media Studio" Width="1280" Height="800" MinWidth="1040" MinHeight="680" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True">
<Window.Resources>
<Style TargetType="Button"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#17324D"/><Setter Property="BorderBrush" Value="#D6DEE7"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="12,6"/><Setter Property="Cursor" Value="Hand"/></Style>
<Style TargetType="TextBox"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CBD6E2"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,6"/></Style>
<Style TargetType="ComboBox"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CBD6E2"/></Style>
</Window.Resources>
<Grid Background="#F3F6FA"><Grid.ColumnDefinitions><ColumnDefinition Width="260" MinWidth="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#17324D"><StackPanel Margin="20"><TextBlock Text="SOCIAL MEDIA STUDIO" Foreground="White" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Stretch" Margin="0,10,0,30"/><Button Content="✚  Create Post" Height="44" Margin="0,0,0,10" Click="NewPost"/><Button Content="▦  Planner" Height="44" Margin="0,0,0,10" Click="ShowPlanner"/><Button Content="▣  Media Library" Height="44" Margin="0,0,0,10" Click="ShowMediaLibrary"/><Button Content="◉  Analytics" Height="44" Margin="0,0,0,10" Click="ShowAnalytics"/><Button Content="●  Connected Accounts" Height="44" Click="ShowAccounts"/></StackPanel></Border>
<Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="#FFFFFF" BorderBrush="#E1E7EE" BorderThickness="0,0,0,1"><Grid Margin="30,0"><TextBlock Text="Social Media Studio" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="#17324D"/><Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#EEF3F8" CornerRadius="18" Padding="14,7"><TextBlock Text="Publishing Dashboard" Foreground="#52677A"/></Border></Grid></Border><Grid Grid.Row="1" Margin="32">
<Grid x:Name="CreatePostView"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Create Post" FontSize="30" FontWeight="SemiBold" Foreground="#17324D"/><TextBlock Text="Create once, customize by network, then publish or schedule." Foreground="#667B8F" Margin="0,5,0,0"/></StackPanel>
<Grid Grid.Row="1" Margin="0,24,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*" MinWidth="320"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="Title" FontSize="17" FontWeight="Bold"/><TextBox x:Name="TitleBox" Height="38" Margin="0,8,18,16" VerticalContentAlignment="Center" MaxLength="100"/><TextBlock Text="Media" FontSize="17" FontWeight="Bold"/><Border x:Name="MediaDropZone" Height="180" Padding="14" Margin="0,8,18,20" BorderBrush="#9AA9B8" BorderThickness="2" CornerRadius="8" Background="White" AllowDrop="True" Drop="MediaDrop" MouseLeftButtonUp="BrowseMedia"><TextBlock x:Name="MediaDropText" Text="Drag &amp; drop video or images here&#10;or click Browse" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Foreground="#52677A"/></Border><TextBlock Text="Caption" FontSize="17" FontWeight="Bold"/><TextBox x:Name="CaptionBox" Height="150" Margin="0,8,18,0" AcceptsReturn="True" TextWrapping="Wrap"/></StackPanel>
<StackPanel Grid.Column="1"><TextBlock Text="YouTube Privacy" FontSize="17" FontWeight="Bold"/><ComboBox x:Name="YouTubePrivacyBox" SelectedIndex="0" Height="36" Margin="0,8,0,18"><ComboBoxItem Content="Private" Tag="private"/><ComboBoxItem Content="Unlisted" Tag="unlisted"/><ComboBoxItem Content="Public" Tag="public"/></ComboBox><TextBlock Text="Publish To" FontSize="17" FontWeight="Bold"/><Border Background="White" BorderBrush="#DCE4EC" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,8,0,20"><WrapPanel><CheckBox Content="Facebook" Tag="Facebook" Checked="PlatformSelectionChanged" Unchecked="PlatformSelectionChanged" Margin="0,6,18,6"/><CheckBox Content="Instagram" Tag="Instagram" Checked="PlatformSelectionChanged" Unchecked="PlatformSelectionChanged" Margin="0,6,18,6"/><CheckBox Content="Threads" Tag="Threads" Checked="PlatformSelectionChanged" Unchecked="PlatformSelectionChanged" Margin="0,6,18,6"/><CheckBox Content="TikTok" Tag="TikTok" Checked="PlatformSelectionChanged" Unchecked="PlatformSelectionChanged" Margin="0,6,18,6"/><CheckBox Content="YouTube" Tag="YouTube" Checked="PlatformSelectionChanged" Unchecked="PlatformSelectionChanged" Margin="0,6,18,6"/><CheckBox Content="X" Tag="X" Checked="PlatformSelectionChanged" Unchecked="PlatformSelectionChanged" Margin="0,6,18,6"/><CheckBox Content="LinkedIn" Tag="LinkedIn" Checked="PlatformSelectionChanged" Unchecked="PlatformSelectionChanged" Margin="0,6,18,6"/><CheckBox Content="Pinterest" Tag="Pinterest" Checked="PlatformSelectionChanged" Unchecked="PlatformSelectionChanged" Margin="0,6,18,6"/></WrapPanel></Border><TextBlock Text="Status" FontSize="17" FontWeight="Bold"/><Border Background="#EEF5FA" CornerRadius="8" Padding="12" Margin="0,8,0,0"><TextBlock x:Name="PublishStatusText" Text="Draft — ready to prepare" Foreground="#52677A" TextWrapping="Wrap"/></Border></StackPanel></Grid>
<Border Grid.Row="2" Background="White" BorderBrush="#E1E7EE" BorderThickness="1" CornerRadius="10" Padding="12"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Save Draft" Width="120" Height="42" Margin="0,0,10,0" Click="SaveDraft"/><DatePicker x:Name="ScheduleDatePicker" Width="130" Height="42" Margin="0,0,8,0"/><TextBox x:Name="ScheduleTimeBox" Width="90" Height="42" Margin="0,0,8,0" Text="6:00 PM" VerticalContentAlignment="Center"/><Button Content="Schedule" Width="120" Height="42" Margin="0,0,10,0" Click="ScheduleDraft"/><Button x:Name="PostNowButton" Content="Publish Now" Width="130" Height="42" Background="#2867D6" Foreground="White" BorderBrush="#2867D6" Click="PostNow"/></StackPanel></Border></Grid>
<Grid x:Name="AnalyticsView" Visibility="Collapsed"><StackPanel><TextBlock Text="Analytics" FontSize="30" FontWeight="SemiBold" Foreground="#17324D"/><DockPanel Margin="0,8,0,22"><TextBlock Text="Publishing overview from your local Social Media Studio history." Foreground="#52677A" VerticalAlignment="Center"/><Button Content="Refresh" HorizontalAlignment="Right" Click="RefreshAnalytics"/></DockPanel><WrapPanel><Border Background="White" BorderBrush="#D6DEE7" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,14,14"><StackPanel><TextBlock Text="Total Posts" Foreground="#52677A"/><TextBlock x:Name="AnalyticsTotal" Text="0" FontSize="28" FontWeight="Bold" Foreground="#17324D"/></StackPanel></Border><Border Background="White" BorderBrush="#D6DEE7" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,14,14"><StackPanel><TextBlock Text="Drafts" Foreground="#52677A"/><TextBlock x:Name="AnalyticsDrafts" Text="0" FontSize="28" FontWeight="Bold" Foreground="#17324D"/></StackPanel></Border><Border Background="White" BorderBrush="#D6DEE7" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,14,14"><StackPanel><TextBlock Text="Published" Foreground="#52677A"/><TextBlock x:Name="AnalyticsPublished" Text="0" FontSize="28" FontWeight="Bold" Foreground="#17324D"/></StackPanel></Border><Border Background="White" BorderBrush="#D6DEE7" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,14,14"><StackPanel><TextBlock Text="Scheduled" Foreground="#52677A"/><TextBlock x:Name="AnalyticsScheduled" Text="0" FontSize="28" FontWeight="Bold" Foreground="#17324D"/></StackPanel></Border><Border Background="White" BorderBrush="#D6DEE7" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,14,14"><StackPanel><TextBlock Text="Needs Attention / Failed" Foreground="#52677A"/><TextBlock x:Name="AnalyticsFailed" Text="0" FontSize="28" FontWeight="Bold" Foreground="#17324D"/></StackPanel></Border><Border Background="White" BorderBrush="#D6DEE7" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,14,14"><StackPanel><TextBlock Text="Success Rate" Foreground="#52677A"/><TextBlock x:Name="AnalyticsSuccessRate" Text="—" FontSize="28" FontWeight="Bold" Foreground="#17324D"/></StackPanel></Border><Border Background="White" BorderBrush="#D6DEE7" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,14,14"><StackPanel><TextBlock Text="Connected Accounts" Foreground="#52677A"/><TextBlock x:Name="AnalyticsConnectedAccounts" Text="0" FontSize="28" FontWeight="Bold" Foreground="#17324D"/></StackPanel></Border><Border Background="White" BorderBrush="#D6DEE7" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,14,14"><StackPanel><TextBlock Text="Publishing Now" Foreground="#52677A"/><TextBlock x:Name="AnalyticsPublishing" Text="0" FontSize="28" FontWeight="Bold" Foreground="#17324D"/></StackPanel></Border><Border Background="White" BorderBrush="#D6DEE7" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,14,14"><StackPanel><TextBlock Text="Posts with Media" Foreground="#52677A"/><TextBlock x:Name="AnalyticsMediaPosts" Text="0" FontSize="28" FontWeight="Bold" Foreground="#17324D"/></StackPanel></Border></WrapPanel><TextBlock Text="Next Scheduled" FontSize="17" FontWeight="Bold" Foreground="#17324D" Margin="0,12,0,8"/><Border Background="White" BorderBrush="#D6DEE7" BorderThickness="1" CornerRadius="10" Padding="16"><TextBlock x:Name="AnalyticsUpcoming" Text="No scheduled posts." Foreground="#52677A" TextWrapping="Wrap"/></Border><TextBlock Text="Platform Distribution" FontSize="17" FontWeight="Bold" Foreground="#17324D" Margin="0,18,0,8"/><Border Background="White" BorderBrush="#D6DEE7" BorderThickness="1" CornerRadius="10" Padding="16"><TextBlock x:Name="AnalyticsPlatformSummary" Text="No platform activity yet." Foreground="#52677A" TextWrapping="Wrap"/></Border><TextBlock Text="Recent Activity" FontSize="17" FontWeight="Bold" Foreground="#17324D" Margin="0,18,0,8"/><Border Background="White" BorderBrush="#D6DEE7" BorderThickness="1" CornerRadius="10" Padding="16"><TextBlock x:Name="AnalyticsRecentActivity" Text="No recent activity." Foreground="#52677A" TextWrapping="Wrap"/></Border></StackPanel></Grid><Grid x:Name="MediaLibraryView" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Media Library" FontSize="30" FontWeight="SemiBold" Foreground="#17324D"/><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,20"><TextBlock Text="Reusable media plus files referenced by saved drafts and scheduled posts." Foreground="#52677A" VerticalAlignment="Center"/><Button Content="Add Media" Width="92" Height="30" Margin="18,0,0,0" Click="AddMediaToLibrary"/></StackPanel><ListBox Grid.Row="2" x:Name="MediaLibraryList" Background="White" BorderBrush="#D6DEE7" Padding="10"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#E1E7EE" BorderThickness="0,0,0,1" Padding="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Use in Post" Width="100" Height="32" Margin="12,0,0,0" Tag="{Binding}" Click="UseLibraryMedia"/><Button Grid.Column="2" Content="Remove" Width="78" Height="32" Margin="8,0,0,0" Tag="{Binding}" Click="RemoveLibraryMedia"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
<Grid x:Name="PlannerView" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Planner" FontSize="30" FontWeight="SemiBold" Foreground="#17324D"/><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,20"><TextBlock Text="Drafts and scheduled posts" Foreground="#52677A" VerticalAlignment="Center"/><Button Content="Refresh" Width="82" Height="30" Margin="18,0,0,0" Click="RefreshPlanner"/></StackPanel><ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="PlannerList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="#D6DEE7" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="#17324D"/><TextBlock Text="{Binding Caption}" Foreground="#52677A" TextTrimming="CharacterEllipsis" MaxWidth="650" Margin="0,4,0,0"/><TextBlock Text="{Binding ScheduledFor, StringFormat={}{0:MMM d, yyyy h:mm tt}}" Foreground="#667B8F" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding State}" FontWeight="SemiBold" Foreground="#2867D6" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Content="Duplicate" Width="82" Height="32" Margin="0,0,6,0" Tag="{Binding Id}" Click="DuplicatePlannerPost"/><Button Content="Edit" Width="70" Height="32" Margin="0,0,6,0" Tag="{Binding Id}" Click="EditPlannerPost"/><Button Content="Delete" Width="70" Height="32" Tag="{Binding Id}" Click="DeletePlannerPost"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid>
<Grid x:Name="AccountsView" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Connected Accounts" FontSize="30" FontWeight="SemiBold" Foreground="#17324D"/><TextBlock Grid.Row="1" Text="Connect, reconnect, or disconnect your publishing channels." Foreground="#52677A" Margin="0,8,0,20"/><ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="AccountsList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="#D6DEE7" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Provider}" FontSize="17" FontWeight="Bold" Foreground="#17324D"/><TextBlock Text="{Binding State}" Foreground="#52677A" Margin="0,4,0,0"/><TextBlock Text="{Binding DisplayName}" Foreground="#2867D6" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Choose Page" Width="95" Height="36" Margin="0,0,8,0" Tag="{Binding Provider}" Click="ChooseFacebookPage"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Provider}" Value="Facebook"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="Connect / Reconnect" Width="130" Height="36" Margin="0,0,8,0" Tag="{Binding Provider}" Click="ConnectAccount"/><Button Content="Disconnect" Width="95" Height="36" Tag="{Binding Provider}" Click="DisconnectAccount"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid>
</Grid></Grid></Grid></Window>